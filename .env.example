# Copy this file to .env and fill in the values.

# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model used for extraction (check https://docs.claude.com for current model names)
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: password for the web app (leave empty to disable)
APP_PASSWORD=

# Optional: token required in the X-API-Key header for the REST API
API_TOKEN=

# Where data is kept
AGREEMENTS_DB=data/agreements.db
UPLOAD_DIR=data/uploads
