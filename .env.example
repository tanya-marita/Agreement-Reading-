# Copy this file to .env and fill in the values.

# Provider: "anthropic" or "google"
LLM_PROVIDER=anthropic

# Required for Anthropic: create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for Google: create a Gemini API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Models used for extraction (check the provider docs for current model names)
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: password for the web app (leave empty to disable)
APP_PASSWORD=

# Optional: token required in the X-API-Key header for the REST API
API_TOKEN=

# Where data is kept
AGREEMENTS_DB=data/agreements.db
UPLOAD_DIR=data/uploads
